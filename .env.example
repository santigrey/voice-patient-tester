# Variable NAMES only. Real values live in ~/.config/voice-patient-tester/.env (outside Drive).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
TELNYX_SIP_USERNAME=
TELNYX_SIP_PASSWORD=
# Number presented on every call (E.164). Verified with the carrier.
CALLER_ID=
# Patient persona. Date of birth is only spoken if the agent asks to verify identity.
PATIENT_NAME=
PATIENT_DOB=
# Optional: a number you own, used only for the one proof call before the real test line.
PROOF_NUMBER=
# Filled in by src/setup_trunk.py
LIVEKIT_SIP_TRUNK_ID=
